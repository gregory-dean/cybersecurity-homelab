le=&quot;font-size:11px;color:#A8A8A8&quot;&gt;kali-01&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#262626;strokeColor=#393939;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=42;spacingRight=10;spacingTop=0;fontFamily=IBM Plex Sans;fontSize=12;" vertex="1" parent="1" id="42"><mxGeometry x="860" y="936" width="400" height="88" as="geometry" /></mxCell><mxCell value="" style="shape=image;html=1;verticalLabelPosition=bottom;labelBackgroundColor=none;imageAspect=0;aspect=fixed;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2378A9FF%22%20stroke-width%3D%221.7%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%223%22%20y%3D%224%22%20width%3D%2218%22%20height%3D%2216%22%20rx%3D%222%22/%3E%3Cpath%20d%3D%22M7%209l4%203-4%203%22/%3E%3Cpath%20d%3D%22M12%2016h5%22/%3E%3C/svg%3E;" vertex="1" parent="1" id="43"><mxGeometry x="872" y="968.0" width="24" height="24" as="geometry" /></mxCell><mxCell value="WHAT CROSSES EACH WALL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#1C1C1C;strokeColor=#393939;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontFamily=IBM Plex Sans;fontSize=11;fontColor=#78A9FF;fontStyle=1;" vertex="1" parent="1" id="44"><mxGeometry x="1304" y="80" width="584" height="968" as="geometry" /></mxCell><mxCell value="&lt;b style=&quot;font-size:11px;color:#78A9FF&quot;&gt;OUTSIDE  ↔  EDGE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#F4F4F4&quot;&gt;Out: Core and lab, after NAT on Sirius.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#F4F4F4&quot;&gt;In: replies only. No inbound services.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#F4F4F4&quot;&gt;This is the only place the desk meets the internet.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#262626;strokeColor=#393939;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontFamily=IBM Plex Sans;fontSize=12;" vertex="1" parent="1" id="45"><mxGeometry x="1324" y="116" width="544" height="140" as="geometry" /></mxCell><mxCell value="&lt;b style=&quot;font-size:11px;color:#78A9FF&quot;&gt;EDGE  ↔  CORE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#F4F4F4&quot;&gt;Sirius LAN is a switch port.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#F4F4F4&quot;&gt;East-west on the switch does not&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#F4F4F4&quot;&gt;reach Sirius.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#262626;strokeColor=#393939;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontFamily=IBM Plex Sans;fontSize=12;" vertex="1" parent="1" id="46"><mxGeometry x="1324" y="272" width="544" height="176" as="geometry" /></mxCell><mxCell value="&lt;b style=&quot;font-size:11px;color:#78A9FF&quot;&gt;CORE  ↔  LAB&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#F4F4F4&quot;&gt;The door is gw-01. It does not NAT.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#F4F4F4&quot;&gt;Sol may enter the lab.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#F4F4F4&quot;&gt;Phones and laptops on Lyra may not.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#F4F4F4&quot;&gt;Lab nets may not start a session to Core.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#F4F4F4&quot;&gt;Lab internet still NATs on Sirius.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#262626;strokeColor=#393939;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontFamily=IBM Plex Sans;fontSize=12;" vertex="1" parent="1" id="47"><mxGeometry x="1324" y="512" width="544" height="320" as="geometry" /></mxCell><mxCell value="&lt;b style=&quot;font-size:11px;color:#78A9FF&quot;&gt;LAB EAST-WEST&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#F4F4F4&quot;&gt;Polaris and Vega share a VXLAN overlay.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#F4F4F4&quot;&gt;labatk may reach labsrv and labep.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#F4F4F4&quot;&gt;Isolation lives on gw-01, not on the switch.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#262626;strokeColor=#393939;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontFamily=IBM Plex Sans;fontSize=12;" vertex="1" parent="1" id="48"><mxGeometry x="1324" y="888" width="544" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="map" name="Map"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#161616" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell value="HOMELAB" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSize=22;fontColor=#78A9FF;fontStyle=1;" vertex="1" parent="1" id="2"><mxGeometry x="40" y="18" width="720" height="28" as="geometry" /></mxCell><mxCell value="Physical path and lab overlay" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSize=13;fontColor=#A8A8A8;fontStyle=0;" vertex="1" parent="1" id="3"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell value="Gregory Dean" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSize=13;fontColor=#F4F4F4;fontStyle=1;" vertex="1" parent="1" id="4"><mxGeometry x="880" y="18" width="680" height="24" as="geometry" /></mxCell><mxCell value="github.com/gregory-dean/Homelab" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSize=12;fontColor=#A8A8A8;fontStyle=0;" vertex